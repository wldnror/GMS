[Unit]
Description=GMS Raspberry Pi graphical console
Documentation=https://github.com/wldnror/GMS
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/GMS
ExecStartPre=/usr/bin/test -x %h/GMS/myenv/bin/python
ExecStartPre=/usr/bin/test -f %h/GMS/main.py
ExecStartPre=/usr/bin/test -d %h/.local/state/gms
ExecStart=%h/GMS/myenv/bin/python %h/GMS/main.py
Environment=GMS_STATE_DIR=%h/.local/state/gms
Environment=GMS_UI_SCALE=1.65
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/gms/gms.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
